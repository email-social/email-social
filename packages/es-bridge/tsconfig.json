{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // DOM: es-core's source (checked through "paths") uses TextDecoder types from it.
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "noEmit": true,
    "paths": {
      "@email-social/es-core": ["../es-core/src/index.ts"]
    }
