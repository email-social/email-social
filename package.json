{
  "name": "email-social",
  "version": "0.1.0",
  "private": true,
  "description": "Email Social: an ordinary mailbox as a chat-like client.",
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/es-core",
    "packages/es-web",
    "packages/es-bridge"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "test": "npm run docs:check && npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test:browser": "npm run test:browser --workspaces --if-present",
    "test:e2e": "npm run test:e2e --workspaces --if-present",
    "vectors:check": "npm run vectors:check --workspaces --if-present",
    "license:check": "node scripts/license-check.mjs",
    "docs:check": "node scripts/docs-check.mjs",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "sbom": "node scripts/sbom.mjs",
    "start": "email-social"
  }
}
